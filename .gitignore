# Private runtime data and development history remain on the local computer.
.codex/
.venv/
.env
.env.*
__pycache__/
*.py[cod]
*.log
*.bak
*.part
settings.json
sessions/
build/
dist/
artifacts/
/_internal/
/ResponsiveClassroom.exe
/resource_manifest.json
/*.zip
